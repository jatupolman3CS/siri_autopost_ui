  "components": {
    "schemas": {
      "AccountDto": {
        "required": [
          "id",
          "platform",
          "name",
          "handle",
          "defaultTarget",
          "health",
          "groups"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "platform": {
            "$ref": "#/components/schemas/Platform"
          },
          "name": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          },
          "defaultTarget": {
            "type": "string"
          },
          "health": {
            "$ref": "#/components/schemas/AccountHealth"
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "AccountHealth": {
        "enum": [
          "ok",
          "warn",
          "relogin"
        ]
      },
      "AntiBanDto": {
        "required": [
          "min",
          "max",
          "limits",
          "typing",
          "scroll",
          "shuffle",
          "autoPause",
          "warmup"
        ],
        "type": "object",
        "properties": {
          "min": {
            "type": "integer",
            "format": "int32"
          },
          "max": {
            "type": "integer",
            "format": "int32"
          },
          "limits": {
            "$ref": "#/components/schemas/PlatformLimitsDto"
          },
          "typing": {
            "type": "boolean"
          },
          "scroll": {
            "type": "boolean"
          },
          "shuffle": {
            "type": "boolean"
          },
          "autoPause": {
            "type": "boolean"
          },
          "warmup": {
            "type": "boolean"
          }
        }
      },
      "AuthResultDto": {
        "required": [
          "token",
          "expiresAt",
          "user"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "user": {
            "$ref": "#/components/schemas/UserDto"
          }
        }
      },
      "ChangePlanRequest": {
        "required": [
          "plan"
        ],
        "type": "object",
        "properties": {
          "plan": {
            "$ref": "#/components/schemas/PlanKey"
          }
        }
      },
      "CreateSnippetRequest": {
        "required": [
          "title",
          "text"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      },
      "CreateWorkspaceRequest": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "EngineSettingsDto": {
        "required": [
          "antiBan",
          "offline",
          "extensionOnline"
        ],
        "type": "object",
        "properties": {
          "antiBan": {
            "$ref": "#/components/schemas/AntiBanDto"
          },
          "offline": {
            "$ref": "#/components/schemas/OfflineDto"
          },
          "extensionOnline": {
            "type": "boolean"
          }
        }
      },
      "ExtensionStateDto": {
        "required": [
          "online",
          "affected"
        ],
        "type": "object",
        "properties": {
          "online": {
            "type": "boolean"
          },
          "affected": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ExtensionStateRequest": {
        "required": [
          "online"
        ],
